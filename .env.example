# Copiá este archivo a .env y ajustá los valores. .env está en .gitignore:
# los secretos reales nunca se commitean.

# Conexión a PostgreSQL (driver psycopg3).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/notifications

# Secreto para firmar los JWT. En producción: un valor largo y aleatorio.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15

# "production" oculta `resetToken` en POST /auth/password-reset/request.
ENVIRONMENT=development

# Umbrales de rate-limit por IP y por endpoint (formato de slowapi).
LOGIN_RATE_LIMIT=5/minute
RESET_REQUEST_RATE_LIMIT=5/minute
