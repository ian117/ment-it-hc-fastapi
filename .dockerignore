# Entornos y artefactos locales: nunca deben entrar al contexto de build.
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Control de versiones y metadatos.
.git
.gitignore

# Secretos y config local.
.env
.claude/

# Tests: no van a la imagen de la app.
tests/

# Docker y CI (no se necesitan dentro del contexto).
Dockerfile
.dockerignore
docker-compose.yml
